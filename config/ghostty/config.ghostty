# --- Font and Visuals ---
# Matches iTerm2's default font and styling
font-family = "SF Mono"
font-size = 12

# Matches iTerm2's default dark color scheme
# theme = iTerm2
# theme = Regular

background = 000000
foreground = c7c7c7
cursor-color = c7c7c7
selection-background = c6dcfc
selection-foreground = 000000
search-foreground = fefb51
search-background = fefb51

# --- Window Styling ---
window-decoration = true
window-padding-x = 8
window-padding-y = 8

# --- macOS Option Key Configuration ---
# Tells Ghostty to treat the Option key as standard Alt/Meta
# This allows Alt+f and Alt+b word jumping to work natively over your AWS connection.
macos-option-as-alt = true

# Force Ghostty to send the literal sequence: Escape (\x1b) then Control+Q ([113;7u) using CSI u protocol.
# keybind = ctrl+alt+q=text:\x1b\x11
keybind = ctrl+alt+q=text:\x1b[113;7u


# Keep native behavior for text copying
# copy-on-select = true
copy-on-select = clipboard

# # --- Manual Reload & Reset Controls ---
# # Forces a manual reload of the configuration file
# keybind = cmd+shift+r=reload_config

# # Resets the terminal screen and scrollback buffer (handy if terminal state gets garbled)
# keybind = cmd+k=clear_screen


# # Forces the mouse wheel/touchpad to send standard arrow key signals 
# # when a full-screen TUI application is active
# mouse-scroll-multiplier = 1.0